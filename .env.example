# Default: saved ChatGPT sign-in through Codex CLI; no API key required.
MODEL_BACKEND=codex
CODEX_MODEL=gpt-6-luna
# Luna accepts none: disable reasoning for short character replies.
CODEX_REASONING_EFFORT=none
CODEX_TIMEOUT=90
# Optional absolute path if codex is not on PATH.
CODEX_BIN=
TELEGRAM_BOT_TOKEN=
# Numeric owner ID; learn it with: python -m joker pair
TELEGRAM_OWNER_ID=
PANEL_PORT=8765
MAX_DAILY_REQUESTS=100
# Optional direct API backend.
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_MODEL=
LLM_API_KEY=

# Optional Minecraft adapter. Disabled unless explicitly enabled or --minecraft is used.
MINECRAFT_ENABLED=0
# Exact trusted server nicknames; separate player and bot accounts.
MINECRAFT_OWNER=
MINECRAFT_BOT=
MINECRAFT_PORT=25333
MINECRAFT_CALLBACK_PORT=25334
