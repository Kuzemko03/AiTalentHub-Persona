# Default: saved ChatGPT sign-in through Codex CLI; no API key required.
MODEL_BACKEND=codex
CODEX_MODEL=gpt-6-luna
CODEX_REASONING_EFFORT=low
CODEX_TIMEOUT=90
# Optional absolute path if codex is not on PATH.
CODEX_BIN=
TELEGRAM_BOT_TOKEN=
# Numeric owner ID; learn it with: python -m joker pair
TELEGRAM_OWNER_ID=
PANEL_PORT=8765
MAX_DAILY_REQUESTS=100
# Optional direct API backend.
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_MODEL=
LLM_API_KEY=
