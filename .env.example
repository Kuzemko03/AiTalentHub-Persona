# Default: saved ChatGPT sign-in through Codex CLI; no API key required.
MODEL_BACKEND=codex
CODEX_MODEL=gpt-6-luna
# Luna accepts none: disable reasoning for short character replies.
CODEX_REASONING_EFFORT=none
CODEX_TIMEOUT=90
# Optional absolute path if codex is not on PATH.
CODEX_BIN=
TELEGRAM_BOT_TOKEN=
# Numeric owner ID; learn it with: python -m joker pair
TELEGRAM_OWNER_ID=
PANEL_PORT=8765
MAX_DAILY_REQUESTS=100
# Optional direct API backend.
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_MODEL=
LLM_API_KEY=

# Optional Minecraft adapter. Disabled unless explicitly enabled or --minecraft is used.
MINECRAFT_ENABLED=0
# Exact trusted server nicknames; separate player and bot accounts.
MINECRAFT_OWNER=
MINECRAFT_BOT=
MINECRAFT_PORT=25333
MINECRAFT_CALLBACK_PORT=25334
MINECRAFT_SERVER=
MINECRAFT_AUTOCONNECT=0

# Optional independent decisions. Enable only from /автономность вкл or the panel.
RUNTIME_INTERVAL=60
RUNTIME_DAILY_REQUESTS=20
# Empty disables the schedule; example: 23:00-08:00, time at UTC_OFFSET.
QUIET_HOURS=
UTC_OFFSET=3

# Audio is opt-in. Full HTTPS endpoints; keys may be empty for local services.
VOICE_ENABLED=0
VOICE_GUESTS=0
STT_URL=
STT_MODEL=
STT_API_KEY=
TTS_URL=
TTS_MODEL=
TTS_API_KEY=
TTS_VOICE=
# Explicit device name or index from python -m joker audio-devices.
VOICE_OUTPUT_DEVICE=
# Optional separate cable that carries other participants' call audio. Empty = no capture.
VOICE_INPUT_DEVICE=
